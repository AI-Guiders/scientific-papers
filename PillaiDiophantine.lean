import AxiomGuard

namespace RotatorCalculusPaper

set_option linter.unusedSimpArgs false
set_option maxHeartbeats 6400000

/-- **Theorem 6 (Pillai Skeletal Joint Matrix Decomposition, Isotropic Discriminant Cone
Generators, and Parabolic `SL₂(ℤ)` Jordan Lock `(P_K ∓ I₂)² ≡ 0`)**:
1. **Skeletal Joint Determinant & Cross-Joint Shift Invariance:**
   For `(A, x_a, x_ma, x_step) ∈ ℤ⁴`, shifting a factor across the joint split satisfies
   `(A * x_ma * x_step) * x_a - (A * x_ma) * (x_step * x_a) = 0`.
2. **Isotropic Discriminant Cone (`Tr² - 4 det = 4 X²`) and Symmetric Generator Factorization:**
   For trace `2 T` and determinant `T² - X²`, `Tr² - 4 det = 4 X²`, vanishing on the isotropic cone `X = 0`;
   along `y_nb = y_b`, `x_ma * x_a - y_b² = (x_ma - y_b) * (x_a - y_b) + y_b * (x_ma + x_a - 2 y_b)`.
3. **Parabolic `SL₂(ℤ)` Jordan Lock `(P_K^{(∓)} ± I₂)² = 0`:**
   For `K ∈ ℤ`, `P_K^{(∓)} = [[∓1 - K, -K], [K, ∓1 + K]]` has `det = +1`, `Tr = ∓2`, and nilpotent
   Jordan square `(P_K^{(∓)} ± I₂)² = [[0, 0], [0, 0]]`. -/
theorem thm6_pillai_skeletal_matrix_decomposition_and_parabolic_sl2_jordan_triptych
    (A xa xma xstep yb K T X : Int) :
    ((A * xma * xstep) * xa - (A * xma) * (xstep * xa) = 0) ∧
    (((T + T) * (T + T) - 4 * (T * T - X * X) = 4 * (X * X)) ∧
     (xma * xa - yb * yb = (xma - yb) * (xa - yb) + yb * (xma + xa - (yb + yb)))) ∧
    (((-1 - K) * (-1 + K) - (-K) * K = 1) ∧
     ((-1 - K) + (-1 + K) = -2) ∧
     ((-K) * (-K) + (-K) * K = 0) ∧
     (K * (-K) + K * K = 0) ∧
     ((1 - K) * (1 + K) - (-K) * K = 1) ∧
     ((1 - K) + (1 + K) = 2)) := by
  have hCone : (T + T) * (T + T) - 4 * (T * T - X * X) = 4 * (X * X) := by
    simp only [Int.mul_add, Int.add_mul, Int.mul_sub]
    omega
  refine ⟨?_, ⟨hCone, ?_⟩, ⟨?_, by omega, ?_, ?_, ?_, by omega⟩⟩ <;>
    (simp only [Int.mul_add, Int.add_mul, Int.mul_sub, Int.sub_mul, Int.mul_neg, Int.neg_mul,
                Int.mul_one, Int.one_mul, Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]; omega)

/-- Cumulative symmetric eigenvalue product `Π_+(ℛ) = ∏_{m=0}^{M-1} r_m` across an arbitrary `M`-floor Padé gear cascade `ℛ : List Int`. -/
def padeTowerProdPlus : List Int → Int
  | [] => 1
  | r :: rest => r * padeTowerProdPlus rest

/-- Cumulative antisymmetric gap eigenvalue product `Π_-(ℛ) = ∏_{m=0}^{M-1} (2 - r_m)` across an arbitrary `M`-floor Padé gear cascade `ℛ : List Int`. -/
def padeTowerProdMinus : List Int → Int
  | [] => 1
  | r :: rest => (2 - r) * padeTowerProdMinus rest

/-- Recursive `M`-floor Padé numerator shaft `P_ℛ(U, V)` generated by engaging the stage-transmission list `ℛ : List Int`. -/
def padeTowerP : List Int → Int → Int → Int
  | [], U, _ => U
  | r :: rest, U, V =>
    let pNext := U + (r - 1) * V
    let qNext := (r - 1) * U + V
    padeTowerP rest pNext qNext

/-- Recursive `M`-floor Padé denominator shaft `Q_ℛ(U, V)` generated by engaging the stage-transmission list `ℛ : List Int`. -/
def padeTowerQ : List Int → Int → Int → Int
  | [], _, V => V
  | r :: rest, U, V =>
    let pNext := U + (r - 1) * V
    let qNext := (r - 1) * U + V
    padeTowerQ rest pNext qNext

theorem padeTowerP_append (R1 R2 : List Int) (U V : Int) :
    padeTowerP (R1 ++ R2) U V = padeTowerP R2 (padeTowerP R1 U V) (padeTowerQ R1 U V) := by
  induction R1 generalizing U V with
  | nil => rfl
  | cons r tl ih =>
    dsimp [padeTowerP, padeTowerQ]
    exact ih (U + (r - 1) * V) ((r - 1) * U + V)

theorem padeTowerQ_append (R1 R2 : List Int) (U V : Int) :
    padeTowerQ (R1 ++ R2) U V = padeTowerQ R2 (padeTowerP R1 U V) (padeTowerQ R1 U V) := by
  induction R1 generalizing U V with
  | nil => rfl
  | cons r tl ih =>
    dsimp [padeTowerP, padeTowerQ]
    exact ih (U + (r - 1) * V) ((r - 1) * U + V)

/-- **Theorem 7 (Three-Level Recursive Descent Invariant, Hankel–Wronskian Square Law,
and `M`-Floor Padé–Thue Gear-Cascade Monoid, Adjacent-Floor Non-Degeneracy `|I_w| + |I_{w++[r]}| ≥ 1`,
and Bilateral Padé Bracket)**: -/
theorem thm7_pillai_recursive_descent_hankel_wronskian_farey_bezout_and_pade_thue_tower
    (R1 R2 : List Int) (kShift At Bt X Y A B u v : Int) :
    let C0 := At * X * X - Bt * Y * Y
    let C1 := At * X - Bt * Y
    let C2 := At - Bt
    let C  := A + B
    let P1k := C + kShift * B
    let Q1k := kShift * C + B
    let I0  := u - v
    let I1k := u * P1k - v * Q1k
    let PR  := padeTowerP R1 C B
    let QR  := padeTowerQ R1 C B
    let IR  := u * PR - v * QR
    let rNext := kShift + 1
    let PNext := padeTowerP (R1 ++ [rNext]) C B
    let QNext := padeTowerQ (R1 ++ [rNext]) C B
    let INext := u * PNext - v * QNext
    (C0 - (X + Y) * C1 + X * Y * C2 = 0) ∧
    (C1 * C1 - C0 * C2 = At * Bt * (X - Y) * (X - Y)) ∧
    (Q1k - P1k = (kShift - 1) * A) ∧
    (Q1k * I0 - I1k = (kShift - 1) * u * A) ∧
    (padeTowerProdPlus (R1 ++ R2) = padeTowerProdPlus R1 * padeTowerProdPlus R2 ∧
     padeTowerProdMinus (R1 ++ R2) = padeTowerProdMinus R1 * padeTowerProdMinus R2 ∧
     padeTowerP (R1 ++ R2) C B = padeTowerP R2 PR QR ∧
     padeTowerQ (R1 ++ R2) C B = padeTowerQ R2 PR QR ∧
     PNext = PR + kShift * QR ∧
     QNext = kShift * PR + QR ∧
     PR + QR = padeTowerProdPlus R1 * (C + B) ∧
     PR - QR = padeTowerProdMinus R1 * A ∧
     QR * I0 - IR = -u * padeTowerProdMinus R1 * A ∧
     INext - (kShift + 1) * IR = -kShift * (u + v) * padeTowerProdMinus R1 * A ∧
     INext + (kShift - 1) * IR = kShift * (u - v) * padeTowerProdPlus R1 * (C + B) ∧
     QNext * IR - QR * INext = kShift * u * padeTowerProdMinus R1 * padeTowerProdPlus R1 * A * (C + B) ∧
     PNext * QR - QNext * PR = -kShift * padeTowerProdMinus R1 * padeTowerProdPlus R1 * A * (C + B) ∧
     (kShift * (u + v) * padeTowerProdMinus R1 * A ≠ 0 →
       ¬ (IR = 0 ∧ INext = 0) ∧ 1 ≤ IR.natAbs + INext.natAbs) ∧
     (IR ≤ 0 → 0 ≤ INext → u * PR ≤ v * QR ∧ v * QNext ≤ u * PNext) ∧
     (INext ≤ 0 → 0 ≤ IR → u * PNext ≤ v * QNext ∧ v * QR ≤ u * PR)) := by
  have hPlus : ∀ (L1 L2 : List Int), padeTowerProdPlus (L1 ++ L2) = padeTowerProdPlus L1 * padeTowerProdPlus L2 := by
    intro L1 L2; induction L1 with
    | nil => dsimp [padeTowerProdPlus]; omega
    | cons r tl ih => dsimp [padeTowerProdPlus]; rw [ih, Int.mul_assoc]
  have hMinus : ∀ (L1 L2 : List Int), padeTowerProdMinus (L1 ++ L2) = padeTowerProdMinus L1 * padeTowerProdMinus L2 := by
    intro L1 L2; induction L1 with
    | nil => dsimp [padeTowerProdMinus]; omega
    | cons r tl ih => dsimp [padeTowerProdMinus]; rw [ih, Int.mul_assoc]
  have hSum : ∀ (L : List Int) (U V : Int),
      padeTowerP L U V + padeTowerQ L U V = padeTowerProdPlus L * (U + V) := by
    intro L; induction L with
    | nil => intro U V; dsimp [padeTowerP, padeTowerQ, padeTowerProdPlus]; omega
    | cons r tl ih =>
      intro U V; dsimp [padeTowerP, padeTowerQ, padeTowerProdPlus]
      rw [ih (U + (r - 1) * V) ((r - 1) * U + V)]
      have hStep : (U + (r - 1) * V) + ((r - 1) * U + V) = r * (U + V) := by
        simp only [Int.mul_add, Int.sub_mul, Int.one_mul]; omega
      rw [hStep]; simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
  have hDiff : ∀ (L : List Int) (U V : Int),
      padeTowerP L U V - padeTowerQ L U V = padeTowerProdMinus L * (U - V) := by
    intro L; induction L with
    | nil => intro U V; dsimp [padeTowerP, padeTowerQ, padeTowerProdMinus]; omega
    | cons r tl ih =>
      intro U V; dsimp [padeTowerP, padeTowerQ, padeTowerProdMinus]
      rw [ih (U + (r - 1) * V) ((r - 1) * U + V)]
      have hStep : (U + (r - 1) * V) - ((r - 1) * U + V) = (2 - r) * (U - V) := by
        simp only [Int.mul_sub, Int.sub_mul, Int.one_mul]; omega
      rw [hStep]; simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
  dsimp
  have hPapp := padeTowerP_append R1 R2 (A + B) B
  have hQapp := padeTowerQ_append R1 R2 (A + B) B
  have hPnext : padeTowerP (R1 ++ [kShift + 1]) (A + B) B =
                padeTowerP R1 (A + B) B + kShift * padeTowerQ R1 (A + B) B := by
    rw [padeTowerP_append R1 [kShift + 1] (A + B) B]
    dsimp [padeTowerP]
    have hSub : kShift + 1 - 1 = kShift := by omega
    rw [hSub]
  have hQnext : padeTowerQ (R1 ++ [kShift + 1]) (A + B) B =
                kShift * padeTowerP R1 (A + B) B + padeTowerQ R1 (A + B) B := by
    rw [padeTowerQ_append R1 [kShift + 1] (A + B) B]
    dsimp [padeTowerQ]
    have hSub : kShift + 1 - 1 = kShift := by omega
    rw [hSub]
  have hS := hSum R1 (A + B) B
  have hD := hDiff R1 (A + B) B
  have hSubAB : (A + B) - B = A := by omega
  rw [hSubAB] at hD
  have hCram : padeTowerQ R1 (A + B) B * (u - v) - (u * padeTowerP R1 (A + B) B - v * padeTowerQ R1 (A + B) B) =
               -u * (padeTowerP R1 (A + B) B - padeTowerQ R1 (A + B) B) := by
    simp only [Int.mul_sub, Int.sub_mul, Int.neg_mul, Int.mul_comm]; omega
  have hCram2 : -u * (padeTowerProdMinus R1 * A) = -u * padeTowerProdMinus R1 * A := by
    simp only [Int.mul_assoc]
  have hAdjDiff : (u * padeTowerP (R1 ++ [kShift + 1]) (A + B) B - v * padeTowerQ (R1 ++ [kShift + 1]) (A + B) B) -
                  (kShift + 1) * (u * padeTowerP R1 (A + B) B - v * padeTowerQ R1 (A + B) B) =
                  -kShift * (u + v) * padeTowerProdMinus R1 * A := by
    rw [hPnext, hQnext]
    have hStep : (u * (padeTowerP R1 (A + B) B + kShift * padeTowerQ R1 (A + B) B) -
                  v * (kShift * padeTowerP R1 (A + B) B + padeTowerQ R1 (A + B) B)) -
                 (kShift + 1) * (u * padeTowerP R1 (A + B) B - v * padeTowerQ R1 (A + B) B) =
                 -(kShift * (u + v) * (padeTowerP R1 (A + B) B - padeTowerQ R1 (A + B) B)) := by
      simp only [Int.mul_add, Int.add_mul, Int.mul_sub, Int.sub_mul, Int.neg_mul, Int.mul_neg,
                 Int.one_mul, Int.mul_one, Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]; omega
    rw [hStep, hD]
    simp only [Int.neg_mul, Int.mul_neg, Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
  have hAdjSum : (u * padeTowerP (R1 ++ [kShift + 1]) (A + B) B - v * padeTowerQ (R1 ++ [kShift + 1]) (A + B) B) +
                 (kShift - 1) * (u * padeTowerP R1 (A + B) B - v * padeTowerQ R1 (A + B) B) =
                 kShift * (u - v) * padeTowerProdPlus R1 * (A + B + B) := by
    rw [hPnext, hQnext]
    have hStep : (u * (padeTowerP R1 (A + B) B + kShift * padeTowerQ R1 (A + B) B) -
                  v * (kShift * padeTowerP R1 (A + B) B + padeTowerQ R1 (A + B) B)) +
                 (kShift - 1) * (u * padeTowerP R1 (A + B) B - v * padeTowerQ R1 (A + B) B) =
                 kShift * (u - v) * (padeTowerP R1 (A + B) B + padeTowerQ R1 (A + B) B) := by
      simp only [Int.mul_add, Int.add_mul, Int.mul_sub, Int.sub_mul,
                 Int.one_mul, Int.mul_one, Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]; omega
    rw [hStep, hS]
    simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
  have hAdjWronsk : padeTowerQ (R1 ++ [kShift + 1]) (A + B) B *
                      (u * padeTowerP R1 (A + B) B - v * padeTowerQ R1 (A + B) B) -
                    padeTowerQ R1 (A + B) B *
                      (u * padeTowerP (R1 ++ [kShift + 1]) (A + B) B - v * padeTowerQ (R1 ++ [kShift + 1]) (A + B) B) =
                    kShift * u * padeTowerProdMinus R1 * padeTowerProdPlus R1 * A * (A + B + B) := by
    rw [hPnext, hQnext]
    have hStep : (kShift * padeTowerP R1 (A + B) B + padeTowerQ R1 (A + B) B) *
                   (u * padeTowerP R1 (A + B) B - v * padeTowerQ R1 (A + B) B) -
                 padeTowerQ R1 (A + B) B *
                   (u * (padeTowerP R1 (A + B) B + kShift * padeTowerQ R1 (A + B) B) -
                    v * (kShift * padeTowerP R1 (A + B) B + padeTowerQ R1 (A + B) B)) =
                 kShift * u * (padeTowerP R1 (A + B) B - padeTowerQ R1 (A + B) B) *
                   (padeTowerP R1 (A + B) B + padeTowerQ R1 (A + B) B) := by
      simp only [Int.mul_add, Int.add_mul, Int.mul_sub, Int.sub_mul,
                 Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]; omega
    rw [hStep, hD, hS]
    simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
  have hPQWronsk : padeTowerP (R1 ++ [kShift + 1]) (A + B) B * padeTowerQ R1 (A + B) B -
                   padeTowerQ (R1 ++ [kShift + 1]) (A + B) B * padeTowerP R1 (A + B) B =
                   -kShift * padeTowerProdMinus R1 * padeTowerProdPlus R1 * A * (A + B + B) := by
    rw [hPnext, hQnext]
    have hStep : (padeTowerP R1 (A + B) B + kShift * padeTowerQ R1 (A + B) B) * padeTowerQ R1 (A + B) B -
                 (kShift * padeTowerP R1 (A + B) B + padeTowerQ R1 (A + B) B) * padeTowerP R1 (A + B) B =
                 -(kShift * (padeTowerP R1 (A + B) B - padeTowerQ R1 (A + B) B) *
                   (padeTowerP R1 (A + B) B + padeTowerQ R1 (A + B) B)) := by
      simp only [Int.mul_add, Int.add_mul, Int.mul_sub, Int.sub_mul, Int.neg_mul, Int.mul_neg,
                 Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]; omega
    rw [hStep, hD, hS]
    simp only [Int.neg_mul, Int.mul_neg, Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
  have hNonDeg : kShift * (u + v) * padeTowerProdMinus R1 * A ≠ 0 →
      ¬ (u * padeTowerP R1 (A + B) B - v * padeTowerQ R1 (A + B) B = 0 ∧
         u * padeTowerP (R1 ++ [kShift + 1]) (A + B) B - v * padeTowerQ (R1 ++ [kShift + 1]) (A + B) B = 0) ∧
      1 ≤ (u * padeTowerP R1 (A + B) B - v * padeTowerQ R1 (A + B) B).natAbs +
          (u * padeTowerP (R1 ++ [kShift + 1]) (A + B) B - v * padeTowerQ (R1 ++ [kShift + 1]) (A + B) B).natAbs := by
    intro hNe0
    have hNotBoth : ¬ (u * padeTowerP R1 (A + B) B - v * padeTowerQ R1 (A + B) B = 0 ∧
                       u * padeTowerP (R1 ++ [kShift + 1]) (A + B) B - v * padeTowerQ (R1 ++ [kShift + 1]) (A + B) B = 0) := by
      rintro ⟨hI0, hIN0⟩
      rw [hI0, hIN0, Int.mul_zero, Int.sub_zero] at hAdjDiff
      have hNegZero : kShift * (u + v) * padeTowerProdMinus R1 * A = 0 := by
        have h1 : - (kShift * (u + v) * padeTowerProdMinus R1 * A) =
                  -kShift * (u + v) * padeTowerProdMinus R1 * A := by
          simp only [Int.neg_mul]
        omega
      exact hNe0 hNegZero
    have hAbsPos : 1 ≤ (u * padeTowerP R1 (A + B) B - v * padeTowerQ R1 (A + B) B).natAbs +
                       (u * padeTowerP (R1 ++ [kShift + 1]) (A + B) B - v * padeTowerQ (R1 ++ [kShift + 1]) (A + B) B).natAbs := by
      rcases Int.lt_trichotomy (u * padeTowerP R1 (A + B) B - v * padeTowerQ R1 (A + B) B) 0 with hLt1 | hEq1 | hGt1
      · omega
      · rcases Int.lt_trichotomy (u * padeTowerP (R1 ++ [kShift + 1]) (A + B) B - v * padeTowerQ (R1 ++ [kShift + 1]) (A + B) B) 0 with hLt2 | hEq2 | hGt2
        · omega
        · exact False.elim (hNotBoth ⟨hEq1, hEq2⟩)
        · omega
      · omega
    exact ⟨hNotBoth, hAbsPos⟩
  refine ⟨?_, ?_, ?_, ?_,
          ⟨hPlus R1 R2, hMinus R1 R2, hPapp, hQapp, hPnext, hQnext, hS, hD,
           by rw [hCram, hD, hCram2],
           hAdjDiff, hAdjSum, hAdjWronsk, hPQWronsk, hNonDeg,
           by intro h1 h2; refine ⟨by omega, by omega⟩,
           by intro h1 h2; refine ⟨by omega, by omega⟩⟩⟩ <;>
    (simp only [Int.mul_add, Int.add_mul, Int.mul_sub, Int.sub_mul,
                Int.mul_one, Int.one_mul, Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]; omega)

/-- **Theorem 10 (Root-Free Cubic Padé–Thue Compression Identity
`U * I₁ * Φ₃(a P̂₁, b Q̂₁) = a³ (U - V)³ (U + V) - (U b³ - V a³) Q̂₁³`)**: -/
theorem thm10_root_free_cubic_pade_compression (U V a b : Int) :
    let Gap := U - V
    let P1  := U + (V + V)
    let Q1  := (U + U) + V
    let I1  := a * P1 - b * Q1
    let uP  := a * P1
    let vQ  := b * Q1
    let phi := uP * uP + uP * vQ + vQ * vQ
    U * I1 * phi =
      (a * a * a) * (Gap * Gap * Gap) * (U + V) -
      (U * (b * b * b) - V * (a * a * a)) * (Q1 * Q1 * Q1) := by
  dsimp
  simp only [Int.mul_add, Int.add_mul, Int.mul_sub, Int.sub_mul,
             Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
  omega

/-- **Theorem 10b (Arbitrary-Floor Two-Solution Collision Law on the Countable Padé Tower `ℛ : List Int`
`At * I_{ℛ,cell} * Φ₃(Y' X P_ℛ, X' Y Q_ℛ) = (Y')³ (U P_ℛ³ - V Q_ℛ³) - C' Y³ Q_ℛ³`,
Adjacent-Floor Escape `I_ℛ = 0 ⟹ I_{ℛ++[k+1]} ≠ 0`, and Gap Principle)**:
For any floor word `ℛ : List Int` of the countable Padé tower (`P_ℛ = padeTowerP ℛ U V`, `Q_ℛ = padeTowerQ ℛ U V`)
and any two solutions `(X, Y)` and `(X', Y')` in the same modulo-`3` residue cell
(`U = At X³`, `V = Bt Y³`, `C = U - V`, `C' = At (X')³ - Bt (Y')³`, `a = Y' X`, `b = X' Y`,
`I_ℛ = a P_ℛ - b Q_ℛ`), the common factor `X³` cancels identically on every floor `ℛ : List Int`,
yielding the arbitrary-floor collision equation, the adjacent-floor non-vanishing escape
`I_ℛ = 0 ⟹ I_{ℛ++[k+1]} = -k (a + b) Π_-(ℛ) C ≠ 0`, and the arbitrary-floor gap bound (`0 Classical.choice`). -/
theorem thm10b_pillai_same_cell_two_solution_collision_and_gap_law
    (R : List Int) (kShift At Bt X Y Xp Yp : Int) :
    let X3 := X * X * X
    let Y3 := Y * Y * Y
    let Xp3 := Xp * Xp * Xp
    let Yp3 := Yp * Yp * Yp
    let U := At * X3
    let V := Bt * Y3
    let C := U - V
    let Cp := At * Xp3 - Bt * Yp3
    let PR := padeTowerP R U V
    let QR := padeTowerQ R U V
    let PNext := padeTowerP (R ++ [kShift + 1]) U V
    let QNext := padeTowerQ (R ++ [kShift + 1]) U V
    let a := Yp * X
    let b := Xp * Y
    let IR := a * PR - b * QR
    let INext := a * PNext - b * QNext
    let uX := a * PR
    let vY := b * QR
    let phi3R := uX * uX + uX * vY + vY * vY
    -- 1. Arbitrary-floor cubic Pade identity and X^3 cancellation across all floors R : List Int:
    (U * (b * b * b) - V * (a * a * a) = X3 * Y3 * Cp) ∧
    (U * IR * phi3R = (a * a * a) * (U * (PR * PR * PR) - V * (QR * QR * QR)) -
                      (U * (b * b * b) - V * (a * a * a)) * (QR * QR * QR)) ∧
    (X3 * (At * IR * phi3R) = X3 * (Yp3 * (U * (PR * PR * PR) - V * (QR * QR * QR)) - Cp * Y3 * (QR * QR * QR))) ∧
    (1 ≤ X3 →
      At * IR * phi3R = Yp3 * (U * (PR * PR * PR) - V * (QR * QR * QR)) - Cp * Y3 * (QR * QR * QR)) ∧
    -- 2. Base floor R = [3] specialization U * P_[3]^3 - V * Q_[3]^3 = C^3 * (U + V):
    (U * ((padeTowerP [3] U V) * (padeTowerP [3] U V) * (padeTowerP [3] U V)) -
     V * ((padeTowerQ [3] U V) * (padeTowerQ [3] U V) * (padeTowerQ [3] U V)) =
     (C * C * C) * (U + V)) ∧
    -- 3. Arbitrary-floor gap bound whenever Yp^3 (U P_R^3 - V Q_R^3) < Cp Y^3 Q_R^3:
    (1 ≤ At → 1 ≤ X3 → 1 ≤ uX → 1 ≤ vY →
     Yp3 * (U * (PR * PR * PR) - V * (QR * QR * QR)) < Cp * Y3 * (QR * QR * QR) →
     3 ≤ phi3R ∧ IR ≤ -1 ∧ IR ≠ 0 ∧
     3 * At ≤ Cp * Y3 * (QR * QR * QR) - Yp3 * (U * (PR * PR * PR) - V * (QR * QR * QR))) ∧
    -- 4. Adjacent-floor escape: if IR = 0 on floor R, then INext on floor R ++ [kShift + 1] is non-zero:
    (IR = 0 →
      INext = -kShift * (a + b) * padeTowerProdMinus R * C ∧
      (kShift * (a + b) * padeTowerProdMinus R * C ≠ 0 → INext ≠ 0 ∧ 1 ≤ INext.natAbs)) := by
  intro X3 Y3 Xp3 Yp3 U V C Cp PR QR PNext QNext a b IR INext uX vY phi3R
  have ha3 : a * a * a = Yp3 * X3 := by
    dsimp [a, Yp3, X3]
    simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
  have hb3 : b * b * b = Xp3 * Y3 := by
    dsimp [b, Xp3, Y3]
    simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
  have hCross : U * (b * b * b) - V * (a * a * a) = X3 * Y3 * Cp := by
    rw [ha3, hb3]
    dsimp [U, V, Cp]
    simp only [Int.mul_sub, Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
  have hGenCube : U * IR * phi3R =
                  (a * a * a) * (U * (PR * PR * PR) - V * (QR * QR * QR)) -
                  (U * (b * b * b) - V * (a * a * a)) * (QR * QR * QR) := by
    dsimp [IR, phi3R, uX, vY]
    simp only [Int.mul_add, Int.add_mul, Int.mul_sub, Int.sub_mul,
               Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
    omega
  have hId : X3 * (At * IR * phi3R) =
             X3 * (Yp3 * (U * (PR * PR * PR) - V * (QR * QR * QR)) - Cp * Y3 * (QR * QR * QR)) := by
    have hBase := hGenCube
    rw [hCross, ha3] at hBase
    have hL : X3 * (At * IR * phi3R) = U * IR * phi3R := by
      dsimp [U]
      simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
    have hR : (Yp3 * X3) * (U * (PR * PR * PR) - V * (QR * QR * QR)) - (X3 * Y3 * Cp) * (QR * QR * QR) =
              X3 * (Yp3 * (U * (PR * PR * PR) - V * (QR * QR * QR)) - Cp * Y3 * (QR * QR * QR)) := by
      simp only [Int.mul_sub, Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
    rw [hL, hBase, hR]
  have hCancelX3 : 1 ≤ X3 →
      At * IR * phi3R = Yp3 * (U * (PR * PR * PR) - V * (QR * QR * QR)) - Cp * Y3 * (QR * QR * QR) := by
    intro hX3pos
    let Lval := At * IR * phi3R
    let Rval := Yp3 * (U * (PR * PR * PR) - V * (QR * QR * QR)) - Cp * Y3 * (QR * QR * QR)
    have hSub0 : X3 * (Lval - Rval) = 0 := by
      dsimp [Lval, Rval]
      rw [Int.mul_sub, hId, Int.sub_self]
    rcases Int.lt_trichotomy Lval Rval with hLt | hEq | hGt
    · have hPos : 0 < X3 * (Rval - Lval) := Int.mul_pos (by omega) (by omega)
      have : X3 * (Rval - Lval) = -(X3 * (Lval - Rval)) := by simp only [Int.mul_sub, Int.neg_sub]
      exact False.elim (Int.lt_irrefl 0 (by omega))
    · exact hEq
    · have hPos : 0 < X3 * (Lval - Rval) := Int.mul_pos (by omega) (by omega)
      exact False.elim (Int.lt_irrefl 0 (by omega))
  have hFloor3 : U * ((padeTowerP [3] U V) * (padeTowerP [3] U V) * (padeTowerP [3] U V)) -
                 V * ((padeTowerQ [3] U V) * (padeTowerQ [3] U V) * (padeTowerQ [3] U V)) =
                 (C * C * C) * (U + V) := by
    have hP3 : padeTowerP [3] U V = U + (V + V) := by dsimp [padeTowerP]; omega
    have hQ3 : padeTowerQ [3] U V = (U + U) + V := by dsimp [padeTowerQ]; omega
    rw [hP3, hQ3]
    dsimp [C]
    simp only [Int.mul_add, Int.add_mul, Int.mul_sub, Int.sub_mul,
               Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
    omega
  refine ⟨hCross, hGenCube, hId, hCancelX3, hFloor3, ?_, ?_⟩
  · intro hAt1 hX31 huX1 hvY1 hGapLt
    have hPure := hCancelX3 hX31
    have huXsq : 1 ≤ uX * uX := Int.mul_pos (by omega : 0 < uX) (by omega : 0 < uX)
    have hvYsq : 1 ≤ vY * vY := Int.mul_pos (by omega : 0 < vY) (by omega : 0 < vY)
    have huvProd : 1 ≤ uX * vY := Int.mul_pos (by omega : 0 < uX) (by omega : 0 < vY)
    have hPhi3 : 3 ≤ phi3R := by dsimp [phi3R]; omega
    have hProdNeg : At * IR * phi3R < 0 := by omega
    have hIclt0 : IR < 0 := by
      rcases Int.lt_trichotomy IR 0 with hLt | hEq | hGt
      · exact hLt
      · have hZero : At * IR * phi3R = 0 := by
          rw [hEq, Int.mul_zero, Int.zero_mul]
        exact False.elim (Int.lt_irrefl 0 (by omega))
      · have hGe0 : 0 ≤ IR := Int.le_of_lt hGt
        have h1 : 0 ≤ At * IR := Int.mul_nonneg (by omega) hGe0
        have h2 : 0 ≤ At * IR * phi3R := Int.mul_nonneg h1 (by omega)
        exact False.elim (Int.lt_irrefl 0 (Int.lt_of_le_of_lt h2 hProdNeg))
    have hIcneg : IR ≤ -1 := Int.le_of_lt_add_one hIclt0
    have hStep1 : At ≤ At * (-IR) := by
      have : At * (-IR) - At = At * (-IR - 1) := by simp only [Int.mul_sub, Int.mul_one]
      have : 0 ≤ At * (-IR - 1) := Int.mul_nonneg (by omega) (by omega)
      omega
    have hStep2 : 3 * (At * (-IR)) ≤ (At * (-IR)) * phi3R := by
      have : (At * (-IR)) * phi3R - 3 * (At * (-IR)) = (At * (-IR)) * (phi3R - 3) := by
        simp only [Int.mul_sub, Int.mul_comm 3 (At * (-IR))]
      have : 0 ≤ (At * (-IR)) * (phi3R - 3) := Int.mul_nonneg (by omega) (by omega)
      omega
    have hEqNeg : (At * (-IR)) * phi3R = -(At * IR * phi3R) := by
      simp only [Int.mul_neg, Int.neg_mul]
    have hFourth : 3 * At ≤ Cp * Y3 * (QR * QR * QR) - Yp3 * (U * (PR * PR * PR) - V * (QR * QR * QR)) := by omega
    exact ⟨hPhi3, hIcneg, Int.ne_of_lt hIclt0, hFourth⟩
  · intro hIR0
    have hThm7 := (thm7_pillai_recursive_descent_hankel_wronskian_farey_bezout_and_pade_thue_tower
                    R [] kShift 0 0 0 0 C V a b).2.2.2.2
    have hUV : C + V = U := by dsimp [C]; omega
    have hAdj : (a * padeTowerP (R ++ [kShift + 1]) (C + V) V - b * padeTowerQ (R ++ [kShift + 1]) (C + V) V) -
                (kShift + 1) * (a * padeTowerP R (C + V) V - b * padeTowerQ R (C + V) V) =
                -kShift * (a + b) * padeTowerProdMinus R * C := hThm7.2.2.2.2.2.2.2.2.2.1
    rw [hUV] at hAdj
    dsimp [PR, QR, PNext, QNext, IR, INext] at hIR0 ⊢
    rw [hIR0, Int.mul_zero, Int.sub_zero] at hAdj
    have hINextEq : a * padeTowerP (R ++ [kShift + 1]) U V - b * padeTowerQ (R ++ [kShift + 1]) U V =
                    -kShift * (a + b) * padeTowerProdMinus R * C := hAdj
    refine ⟨hINextEq, ?_⟩
    intro hNe0
    have hINextNe0 : a * padeTowerP (R ++ [kShift + 1]) U V - b * padeTowerQ (R ++ [kShift + 1]) U V ≠ 0 := by
      intro hZero
      rw [hINextEq] at hZero
      have : kShift * (a + b) * padeTowerProdMinus R * C = 0 := by
        have hNeg : -(kShift * (a + b) * padeTowerProdMinus R * C) =
                    -kShift * (a + b) * padeTowerProdMinus R * C := by simp only [Int.neg_mul]
        omega
      exact hNe0 this
    have hAbs1 : 1 ≤ (a * padeTowerP (R ++ [kShift + 1]) U V - b * padeTowerQ (R ++ [kShift + 1]) U V).natAbs := by
      rcases Int.lt_trichotomy (a * padeTowerP (R ++ [kShift + 1]) U V - b * padeTowerQ (R ++ [kShift + 1]) U V) 0 with hLt | hEq | hGt
      · omega
      · exact False.elim (hINextNe0 hEq)
      · omega
    exact ⟨hINextNe0, hAbs1⟩

/-- **Theorem 10c (Closed-Form Cubic Padé Residual `8 (U P_R³ - V Q_R³)` across Arbitrary Floors `R : List Int`,
Leading-Term Annihilation Condition `Π_+(R) + 3 Π_-(R) = 0`, and Annihilating-Floor Collision Gap Law)**:
For every floor `R : List Int` of the countable Padé–Thue tower `(P_R, Q_R) = (padeTowerP R U V, padeTowerQ R U V)`
with `C = U - V`, `S = U + V`, `Π_+(R) = padeTowerProdPlus R`, `Π_-(R) = padeTowerProdMinus R`,
`Φ₃(P_R, Q_R) = P_R² + P_R Q_R + Q_R²`, and `Ψ₃(P_R, Q_R) = P_R² - P_R Q_R + Q_R²`:
1. **Exact Divisibility by `C = U - V` and `C (U + V)` on Every Floor `R : List Int`:**
   - `U * P_R³ - V * Q_R³ = C * (Π_-(R) * U * Φ₃(P_R, Q_R) + Q_R³) = C * (Π_-(R) * V * Φ₃(P_R, Q_R) + P_R³)`,
   - `2 * (U * P_R³ - V * Q_R³) = C * S * (Π_-(R) * Φ₃(P_R, Q_R) + Π_+(R) * Ψ₃(P_R, Q_R))`.
2. **Closed-Form Decomposition of `8 (U P_R³ - V Q_R³)` in Terms of `(Π_+(R), Π_-(R), C, U + V)`:**
   `8 * (U * P_R³ - V * Q_R³) = C * S * (Π_+(R)² * (Π_+(R) + 3 * Π_-(R)) * S² + Π_-(R)² * (3 * Π_+(R) + Π_-(R)) * C²)`.
3. **Leading-Term Cubic Annihilation on Any Floor `R` with `Π_+(R) + 3 * Π_-(R) = 0`:**
   Whenever `Π_+(R) + 3 * Π_-(R) = 0` (such as `R = [3]` or any word with `∏ r_i = -3 ∏ (2 - r_i)`),
   the `(U + V)³` leading term vanishes identically and
   `U * P_R³ - V * Q_R³ = -(Π_-(R) * Π_-(R) * Π_-(R)) * (C * C * C) * S`. -/
theorem thm10c_pillai_arbitrary_floor_closed_cubic_residual_and_annihilation_condition
    (R : List Int) (U V : Int) :
    let C := U - V
    let S := U + V
    let PR := padeTowerP R U V
    let QR := padeTowerQ R U V
    let Pp := padeTowerProdPlus R
    let Pm := padeTowerProdMinus R
    let phi3 := PR * PR + PR * QR + QR * QR
    let psi3 := PR * PR - PR * QR + QR * QR
    (U * (PR * PR * PR) - V * (QR * QR * QR) = C * (Pm * U * phi3 + QR * QR * QR) ∧
     U * (PR * PR * PR) - V * (QR * QR * QR) = C * (Pm * V * phi3 + PR * PR * PR)) ∧
    (2 * (U * (PR * PR * PR) - V * (QR * QR * QR)) =
      C * S * (Pm * phi3 + Pp * psi3)) ∧
    (8 * (U * (PR * PR * PR) - V * (QR * QR * QR)) =
      C * S * ((Pp * Pp) * (Pp + 3 * Pm) * (S * S) + (Pm * Pm) * (3 * Pp + Pm) * (C * C))) ∧
    (Pp + 3 * Pm = 0 →
      U * (PR * PR * PR) - V * (QR * QR * QR) = -(Pm * Pm * Pm) * (C * C * C) * S) := by
  intro C S PR QR Pp Pm phi3 psi3
  have h7 := (thm7_pillai_recursive_descent_hankel_wronskian_farey_bezout_and_pade_thue_tower
               R [] 0 0 0 0 0 (U - V) V 0 0).2.2.2.2
  have hUV : (U - V) + V = U := by omega
  rw [hUV] at h7
  have hSum : PR + QR = Pp * S := h7.2.2.2.2.2.2.1
  have hDiff : PR - QR = Pm * C := h7.2.2.2.2.2.2.2.1
  have hId1 : U * (PR * PR * PR) - V * (QR * QR * QR) =
              U * (PR - QR) * phi3 + C * (QR * QR * QR) := by
    dsimp [phi3, C]
    simp only [Int.mul_add, Int.add_mul, Int.mul_sub, Int.sub_mul,
               Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]; omega
  have hId2 : U * (PR * PR * PR) - V * (QR * QR * QR) =
              V * (PR - QR) * phi3 + C * (PR * PR * PR) := by
    dsimp [phi3, C]
    simp only [Int.mul_add, Int.add_mul, Int.mul_sub, Int.sub_mul,
               Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]; omega
  have hDiv1 : U * (PR * PR * PR) - V * (QR * QR * QR) =
               C * (Pm * U * phi3 + QR * QR * QR) := by
    rw [hId1, hDiff]
    simp only [Int.mul_add, Int.add_mul, Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
  have hDiv2 : U * (PR * PR * PR) - V * (QR * QR * QR) =
               C * (Pm * V * phi3 + PR * PR * PR) := by
    rw [hId2, hDiff]
    simp only [Int.mul_add, Int.add_mul, Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
  have hId2x : (U * (PR * PR * PR) - V * (QR * QR * QR)) + (U * (PR * PR * PR) - V * (QR * QR * QR)) =
               S * (PR - QR) * phi3 + C * (PR + QR) * psi3 := by
    dsimp [phi3, psi3, C, S]
    simp only [Int.mul_add, Int.add_mul, Int.mul_sub, Int.sub_mul,
               Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]; omega
  have hDiv2x : 2 * (U * (PR * PR * PR) - V * (QR * QR * QR)) =
                C * S * (Pm * phi3 + Pp * psi3) := by
    have h2 : 2 * (U * (PR * PR * PR) - V * (QR * QR * QR)) =
              (U * (PR * PR * PR) - V * (QR * QR * QR)) + (U * (PR * PR * PR) - V * (QR * QR * QR)) := by omega
    rw [h2, hId2x, hDiff, hSum]
    simp only [Int.mul_add, Int.add_mul, Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
  have hPhi4 : phi3 + phi3 + phi3 + phi3 =
               ((PR + QR) * (PR + QR) + (PR + QR) * (PR + QR) + (PR + QR) * (PR + QR)) +
               (PR - QR) * (PR - QR) := by
    dsimp [phi3]
    simp only [Int.mul_add, Int.add_mul, Int.mul_sub, Int.sub_mul,
               Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]; omega
  have hPsi4 : psi3 + psi3 + psi3 + psi3 =
               (PR + QR) * (PR + QR) +
               ((PR - QR) * (PR - QR) + (PR - QR) * (PR - QR) + (PR - QR) * (PR - QR)) := by
    dsimp [psi3]
    simp only [Int.mul_add, Int.add_mul, Int.mul_sub, Int.sub_mul,
               Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]; omega
  have hClosed8x : 8 * (U * (PR * PR * PR) - V * (QR * QR * QR)) =
      C * S * ((Pp * Pp) * (Pp + 3 * Pm) * (S * S) +
               (Pm * Pm) * (3 * Pp + Pm) * (C * C)) := by
    have h8from2 : 8 * (U * (PR * PR * PR) - V * (QR * QR * QR)) =
                   4 * (2 * (U * (PR * PR * PR) - V * (QR * QR * QR))) := by omega
    have h4 : 4 * (C * S * (Pm * phi3 + Pp * psi3)) =
              C * S * (Pm * (phi3 + phi3 + phi3 + phi3) + Pp * (psi3 + psi3 + psi3 + psi3)) := by
      have h4phi : 4 * phi3 = phi3 + phi3 + phi3 + phi3 := by omega
      have h4psi : 4 * psi3 = psi3 + psi3 + psi3 + psi3 := by omega
      rw [← h4phi, ← h4psi]
      simp only [Int.mul_add, Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
    have h3Pm : Pp + 3 * Pm = Pp + (Pm + Pm + Pm) := by omega
    have h3Pp : 3 * Pp + Pm = (Pp + Pp + Pp) + Pm := by omega
    rw [h8from2, hDiv2x, h4, hPhi4, hPsi4, h3Pm, h3Pp, hSum, hDiff]
    simp only [Int.mul_add, Int.add_mul, Int.mul_sub, Int.sub_mul,
               Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]; omega
  refine ⟨⟨hDiv1, hDiv2⟩, hDiv2x, hClosed8x, ?_⟩
  intro hAnn
  have h8Ann : 8 * (U * (PR * PR * PR) - V * (QR * QR * QR)) =
               8 * (-(Pm * Pm * Pm) * (C * C * C) * S) := by
    rw [hClosed8x, hAnn, Int.mul_zero, Int.zero_mul, Int.zero_add]
    have h3 : 3 * Pp + Pm = -8 * Pm := by omega
    rw [h3]
    simp only [Int.mul_neg, Int.neg_mul, Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
  omega

/-- **Theorem 11 (Cross-Floor Padé Wronskian `W_{2,3}` Identity
`Q̂_{1,2}² P̂_{1,3}³ - P̂_{1,2}² Q̂_{1,3}³ = (U - V)³ (U² + 3UV + V²)` and Right Kernel & Trace
of `P₃(A, B, A+B)`)**: -/
theorem thm11_cross_floor_wronskian_and_p3_kernel (A B U V : Int) :
    let C := A + B
    let Gap := U - V
    let P1_2 := U + (V + V + V)
    let Q1_2 := (U + U + U) + V
    let P1_3 := U + (V + V)
    let Q1_3 := (U + U) + V
    let phi23 := U * U + (U + U + U) * V + V * V
    ((U + V) * (P1_2 * P1_2) - (P1_3 * P1_3 * P1_3) = V * phi23) ∧
    ((U + V) * (Q1_2 * Q1_2) - (Q1_3 * Q1_3 * Q1_3) = U * phi23) ∧
    ((Q1_2 * Q1_2) * (P1_3 * P1_3 * P1_3) - (P1_2 * P1_2) * (Q1_3 * Q1_3 * Q1_3) =
      (Gap * Gap * Gap) * phi23) ∧
    (A * A * (B + C) + B * B * (A + C) + C * C * (A - B) = A * C * (A + C)) ∧
    (let p00 := A * A * (B + C)
     let p01 := (B + (C + C)) * (B + (C + C)) * (B + (C + C))
     let p02 := ((B + B) + C) * ((B + B) + C) * ((B + B) + C)
     let p10 := (A + (C + C)) * (A + (C + C)) * (A + (C + C))
     let p11 := B * B * (A + C)
     let p12 := ((A + A) + C) * ((A + A) + C) * ((A + A) + C)
     let p20 := (A - (B + B)) * (A - (B + B)) * (A - (B + B))
     let p21 := ((A + A) - B) * ((A + A) - B) * ((A + A) - B)
     let p22 := C * C * (A - B)
     (p00 * A + p01 * B - p02 * C = 0) ∧
     (p10 * A + p11 * B - p12 * C = 0) ∧
     (p20 * A + p21 * B - p22 * C = 0)) := by
  dsimp
  refine ⟨?_, ?_, ?_, ?_, ⟨?_, ?_, ?_⟩⟩ <;>
    (simp only [Int.mul_add, Int.add_mul, Int.mul_sub, Int.sub_mul,
                Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]; omega)

end RotatorCalculusPaper
